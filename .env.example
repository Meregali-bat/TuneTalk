# Servidor
PORT=3000
SESSION_SECRET=troque-este-valor
# true quando servido via HTTPS (atrás de proxy)
COOKIE_SECURE=false

# Postgres (local via docker compose, ou Neon/RDS/etc.)
DATABASE_URL=postgresql://tunetalk:tunetalk@localhost:5432/tunetalk
# Só no Neon: conexão direta (sem "-pooler" no host), usada pelas migrations
# DATABASE_URL_UNPOOLED=

# Cloudinary (upload de fotos de perfil)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# "Esqueci minha senha" (Resend). Sem a chave, o email só aparece no terminal.
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend. Sem domínio, o Resend só entrega para o dono da conta.
EMAIL_FROM=TuneTalk <onboarding@resend.dev>
# Base dos links enviados por email (na Vercel, sem isso usa o domínio de produção)
APP_URL=http://localhost:5173
