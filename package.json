{
  "name": "tunetalk",
  "version": "2.0.0",
  "description": "Rede social de música — API Express + SPA React",
  "type": "module",
  "main": "server/src/index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon --watch server/src server/src/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo && node scripts/build-demo-page.js",
    "vercel-build": "node scripts/check-db-before-migrate.js && prisma migrate deploy && vite build",
    "start": "NODE_ENV=production node server/src/index.js",
    "postinstall": "npm run db:generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev && npm run db:generate",
    "db:generate": "node scripts/prisma-to-js.js --clean && prisma generate && node --no-warnings scripts/prisma-to-js.js",
    "db:import": "node scripts/migrate-mysql-dump.js",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run --project server",
    "test:client": "vitest run --project client"
  },
  "author": "Lucas Meregali",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/og": "^0.8.5",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "cloudinary": "^1.41.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "md5": "^2.3.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-router-dom": "^7.18.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "pglite-prisma-adapter": "^0.7.2",
    "supertest": "^7.3.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
