{
  "name": "tunetalk",
  "version": "2.0.0",
  "description": "Rede social de música — API Express + SPA React",
  "type": "module",
  "main": "server/src/index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon --watch server/src server/src/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run --project server",
    "test:client": "vitest run --project client"
  },
  "author": "Lucas Meregali",
  "license": "ISC",
  "dependencies": {
    "aos": "^3.0.0-beta.6",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "cloudinary": "^1.41.3",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "md5": "^2.3.0",
    "moment": "^2.31.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
