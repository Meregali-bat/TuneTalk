generator client {
  provider            = "prisma-client"
  output              = "../server/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts" // convertido para .js por scripts/prisma-to-js.js
}

datasource db {
  provider = "postgresql"
}

enum TipoNotificacao {
  like
  comment
  new_follower
}

model Usuario {
  id           Int     @id @default(autoincrement())
  // Nome de usuário: escolhido depois do cadastro, por isso pode ficar vazio até lá.
  nome         String? @unique @db.VarChar(45)
  email        String  @unique @db.VarChar(100)
  senha        String  @db.VarChar(65)
  fotoPerfil   String? @map("foto_perfil") @db.VarChar(255)
  bio          String? @db.VarChar(255)
  // Nome de exibição (livre, como no Twitter); sem ele, o perfil mostra o nome de usuário.
  nomeExibicao String? @map("nome_exibicao") @db.VarChar(50)
  // Capa do perfil, enviada direto ao Cloudinary (pasta tunetalk/banners).
  bannerUrl    String? @map("banner_url") @db.VarChar(500)
  admin        Boolean @default(false)
  // Post que aparece primeiro no perfil. Se o post for apagado, volta a ficar vazio.
  postFixadoId Int?    @unique @map("post_fixado_id")

  posts                 Post[]
  curtidas              Curtida[]
  seguindo              Seguimento[]       @relation("seguidor")
  seguidores            Seguimento[]       @relation("seguido")
  notificacoesRecebidas Notificacao[]      @relation("destinatario")
  notificacoesEnviadas  Notificacao[]      @relation("autor")
  redefinicoesSenha     RedefinicaoSenha[]
  postFixado            Post?              @relation("fixado", fields: [postFixadoId], references: [id], onDelete: SetNull)

  @@map("usuarios")
}

// Comentários também são posts: uma resposta aponta para o post pai e pode ter música ou não.
model Post {
  id           Int      @id @default(autoincrement())
  texto        String   @db.VarChar(5000)
  musicName    String?  @map("music_name") @db.VarChar(255)
  artistName   String?  @map("artist_name") @db.VarChar(255)
  posterMusica String?  @map("poster_musica") @db.VarChar(255)
  albumName    String?  @map("album_name") @db.VarChar(255)
  posterAlbum  String?  @map("poster_album") @db.VarChar(255)
  postType     String?  @map("post_type") @db.VarChar(20)
  // Faixas guardam a duração em segundos; álbuns, a data de lançamento.
  releaseDate  String?  @map("release_date") @db.VarChar(20)
  // De 0 a 10: cada ponto é meia estrela. Vazia quando o post não tem música.
  nota         Int?
  musicPreview String?  @map("music_preview") @db.VarChar(2000)
  // Imagem ou GIF enviado direto ao Cloudinary (pasta tunetalk/posts).
  imagemUrl    String?  @map("imagem_url") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  autorId      Int      @map("autor_id")
  parentId     Int?     @map("parent_id")

  autor        Usuario       @relation(fields: [autorId], references: [id], onDelete: Cascade)
  pai          Post?         @relation("respostas", fields: [parentId], references: [id], onDelete: Cascade)
  respostas    Post[]        @relation("respostas")
  fixadoPor    Usuario?      @relation("fixado")
  curtidas     Curtida[]
  notificacoes Notificacao[]

  @@index([autorId])
  @@index([createdAt])
  @@index([parentId])
  @@map("posts")
}

model Curtida {
  postId    Int      @map("post_id")
  usuarioId Int      @map("usuario_id")
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([postId, usuarioId])
  @@index([usuarioId])
  @@map("curtidas")
}

model Seguimento {
  seguidorId Int      @map("seguidor_id")
  seguidoId  Int      @map("seguido_id")
  createdAt  DateTime @default(now()) @map("created_at")

  seguidor Usuario @relation("seguidor", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguido  Usuario @relation("seguido", fields: [seguidoId], references: [id], onDelete: Cascade)

  @@id([seguidorId, seguidoId])
  @@index([seguidoId])
  @@map("seguimentos")
}

model Notificacao {
  id             Int             @id @default(autoincrement())
  tipo           TipoNotificacao
  conteudo       String          @db.VarChar(255)
  lida           Boolean         @default(false)
  createdAt      DateTime        @default(now()) @map("created_at")
  destinatarioId Int             @map("destinatario_id")
  autorId        Int             @map("autor_id")
  postId         Int?            @map("post_id")

  destinatario Usuario @relation("destinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)
  autor        Usuario @relation("autor", fields: [autorId], references: [id], onDelete: Cascade)
  post         Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([destinatarioId, lida])
  @@map("notificacoes")
}

// Sessões de login (express-session + connect-pg-simple). Ficam no banco porque na
// Vercel cada requisição pode cair numa instância diferente do servidor.
model Sessao {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// Pedidos de "esqueci minha senha". Guarda só o hash (sha256) do código enviado por email:
// quem lê o banco não consegue usar o link.
model RedefinicaoSenha {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("redefinicoes_senha")
}
