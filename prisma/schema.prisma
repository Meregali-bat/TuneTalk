generator client {
  provider            = "prisma-client"
  output              = "../server/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts" // convertido para .js por scripts/prisma-to-js.js
}

datasource db {
  provider = "postgresql"
}

enum TipoNotificacao {
  like
  comment
  new_follower
  selo_fundador
  mention
  voto_enquete
  marco_posts
}

model Usuario {
  id                  Int       @id @default(autoincrement())
  // Nome de usuário: escolhido depois do cadastro, por isso pode ficar vazio até lá.
  nome                String?   @unique @db.VarChar(45)
  email               String    @unique @db.VarChar(100)
  senha               String    @db.VarChar(65)
  fotoPerfil          String?   @map("foto_perfil") @db.VarChar(255)
  bio                 String?   @db.VarChar(255)
  // Nome de exibição (livre, como no Twitter); sem ele, o perfil mostra o nome de usuário.
  nomeExibicao        String?   @map("nome_exibicao") @db.VarChar(50)
  // Favoritos do perfil: { musicas, albuns, artistas }, até 5 de cada (dados do Deezer).
  favoritos           Json      @default("{}")
  // Capa do perfil, enviada direto ao Cloudinary (pasta tunetalk/banners).
  bannerUrl           String?   @map("banner_url") @db.VarChar(500)
  // Conta que veio do TuneTalk antigo (ids preservados na migração). Ganha o selo de fundador
  // no próximo login, quando fundadorDesde é preenchido.
  veterano            Boolean   @default(false)
  fundadorDesde       DateTime? @map("fundador_desde")
  // A pessoa escolhe no Editar perfil se a medalha de fundador aparece.
  mostrarSeloFundador Boolean   @default(true) @map("mostrar_selo_fundador")
  admin               Boolean   @default(false)
  // Post que aparece primeiro no perfil. Se o post for apagado, volta a ficar vazio.
  postFixadoId        Int?      @unique @map("post_fixado_id")
  // Recompensa dos 100 posts: quando o efeito do perfil foi desbloqueado (fica para sempre,
  // mesmo que a pessoa apague posts), o efeito escolhido ({ tipo, paleta }) e se ele aparece.
  efeitoDesde         DateTime? @map("efeito_desde")
  efeitoPerfil        Json?     @map("efeito_perfil")
  mostrarEfeito       Boolean   @default(true) @map("mostrar_efeito")

  posts                 Post[]
  curtidas              Curtida[]
  seguindo              Seguimento[]       @relation("seguidor")
  seguidores            Seguimento[]       @relation("seguido")
  notificacoesRecebidas Notificacao[]      @relation("destinatario")
  notificacoesEnviadas  Notificacao[]      @relation("autor")
  aparelhosPush         InscricaoPush[]
  votosEnquete          EnqueteVoto[]
  redefinicoesSenha     RedefinicaoSenha[]
  bloqueados            Bloqueio[]         @relation("bloqueador")
  bloqueadoPor          Bloqueio[]         @relation("bloqueado")
  silenciados           Silencio[]         @relation("silenciador")
  silenciadoPor         Silencio[]         @relation("silenciado")
  queroOuvir            QueroOuvir[]
  postFixado            Post?              @relation("fixado", fields: [postFixadoId], references: [id], onDelete: SetNull)

  @@map("usuarios")
}

// Comentários também são posts: uma resposta aponta para o post pai e pode ter música ou não.
model Post {
  id              Int      @id @default(autoincrement())
  texto           String   @db.VarChar(5000)
  musicName       String?  @map("music_name") @db.VarChar(255)
  artistName      String?  @map("artist_name") @db.VarChar(255)
  posterMusica    String?  @map("poster_musica") @db.VarChar(255)
  albumName       String?  @map("album_name") @db.VarChar(255)
  posterAlbum     String?  @map("poster_album") @db.VarChar(255)
  postType        String?  @map("post_type") @db.VarChar(20)
  // Faixas guardam a duração em segundos; álbuns, a data de lançamento.
  releaseDate     String?  @map("release_date") @db.VarChar(20)
  // De 0 a 10: cada ponto é meia estrela. Vazia quando o post não tem música.
  nota            Int?
  musicPreview    String?  @map("music_preview") @db.VarChar(2000)
  // Imagem ou GIF enviado direto ao Cloudinary (pasta tunetalk/posts).
  imagemUrl       String?  @map("imagem_url") @db.VarChar(500)
  // Proporção (largura/altura) escolhida ao cortar. Vazia nos posts antigos, que seguem como eram.
  imagemProporcao Float?   @map("imagem_proporcao") @db.Real
  // Trecho da letra (até 4 versos, um por linha), escolhido na LRCLIB. Só em posts de música.
  trechoLetra     String?  @map("trecho_letra") @db.VarChar(700)
  // Enquete de músicas: quando termina (vazio se o post não tem enquete). As opções ficam em enquete_opcoes.
  enqueteFim      DateTime? @map("enquete_fim")
  createdAt       DateTime @default(now()) @map("created_at")
  autorId         Int      @map("autor_id")
  parentId        Int?     @map("parent_id")

  autor        Usuario       @relation(fields: [autorId], references: [id], onDelete: Cascade)
  pai          Post?         @relation("respostas", fields: [parentId], references: [id], onDelete: Cascade)
  respostas    Post[]        @relation("respostas")
  opcoesEnquete EnqueteOpcao[]
  votosEnquete  EnqueteVoto[]
  fixadoPor    Usuario?      @relation("fixado")
  curtidas     Curtida[]
  notificacoes Notificacao[]

  @@index([autorId])
  @@index([createdAt])
  @@index([parentId])
  @@map("posts")
}

model Curtida {
  postId    Int      @map("post_id")
  usuarioId Int      @map("usuario_id")
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([postId, usuarioId])
  @@index([usuarioId])
  @@map("curtidas")
}

// "Quero ouvir": álbuns e músicas que a pessoa guardou para ouvir depois. Sai da lista quando ela
// avalia o disco. `chave` é tipo|título|artista em minúsculas (o mesmo critério da página do disco).
model QueroOuvir {
  id          Int      @id @default(autoincrement())
  usuarioId   Int      @map("usuario_id")
  tipo        String   @db.VarChar(10)
  titulo      String   @db.VarChar(255)
  artista     String   @db.VarChar(255)
  capa        String?  @db.VarChar(500)
  releaseDate String?  @map("release_date") @db.VarChar(20)
  preview     String?  @db.VarChar(2000)
  chave       String   @db.VarChar(530)
  createdAt   DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, chave])
  @@map("quero_ouvir")
}

// Bloquear: nenhum dos dois vê os posts do outro nem interage com ele (seguir, curtir, comentar...).
model Bloqueio {
  bloqueadorId Int      @map("bloqueador_id")
  bloqueadoId  Int      @map("bloqueado_id")
  createdAt    DateTime @default(now()) @map("created_at")

  bloqueador Usuario @relation("bloqueador", fields: [bloqueadorId], references: [id], onDelete: Cascade)
  bloqueado  Usuario @relation("bloqueado", fields: [bloqueadoId], references: [id], onDelete: Cascade)

  @@id([bloqueadorId, bloqueadoId])
  @@index([bloqueadoId])
  @@map("bloqueios")
}

// Silenciar: quem silenciou deixa de ver os posts e de receber notificações da outra pessoa,
// sem ela saber.
model Silencio {
  usuarioId    Int      @map("usuario_id")
  silenciadoId Int      @map("silenciado_id")
  createdAt    DateTime @default(now()) @map("created_at")

  usuario    Usuario @relation("silenciador", fields: [usuarioId], references: [id], onDelete: Cascade)
  silenciado Usuario @relation("silenciado", fields: [silenciadoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, silenciadoId])
  @@map("silencios")
}

model Seguimento {
  seguidorId Int      @map("seguidor_id")
  seguidoId  Int      @map("seguido_id")
  createdAt  DateTime @default(now()) @map("created_at")

  seguidor Usuario @relation("seguidor", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguido  Usuario @relation("seguido", fields: [seguidoId], references: [id], onDelete: Cascade)

  @@id([seguidorId, seguidoId])
  @@index([seguidoId])
  @@map("seguimentos")
}

model Notificacao {
  id             Int             @id @default(autoincrement())
  tipo           TipoNotificacao
  conteudo       String          @db.VarChar(255)
  lida           Boolean         @default(false)
  createdAt      DateTime        @default(now()) @map("created_at")
  destinatarioId Int             @map("destinatario_id")
  autorId        Int             @map("autor_id")
  postId         Int?            @map("post_id")

  destinatario Usuario @relation("destinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)
  autor        Usuario @relation("autor", fields: [autorId], references: [id], onDelete: Cascade)
  post         Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([destinatarioId, lida])
  @@map("notificacoes")
}

// Opções de uma enquete de músicas (de 2 a 4), na ordem em que aparecem.
model EnqueteOpcao {
  id      Int     @id @default(autoincrement())
  postId  Int     @map("post_id")
  posicao Int
  titulo  String  @db.VarChar(255)
  artista String? @db.VarChar(255)
  capa    String? @db.VarChar(500)
  preview String? @db.VarChar(2000)

  post  Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  votos EnqueteVoto[]

  @@unique([postId, posicao])
  @@map("enquete_opcoes")
}

// Um voto por pessoa em cada enquete.
model EnqueteVoto {
  postId    Int      @map("post_id")
  usuarioId Int      @map("usuario_id")
  opcaoId   Int      @map("opcao_id")
  createdAt DateTime @default(now()) @map("created_at")

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  usuario Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  opcao   EnqueteOpcao @relation(fields: [opcaoId], references: [id], onDelete: Cascade)

  @@id([postId, usuarioId])
  @@index([opcaoId])
  @@map("enquete_votos")
}

// Aparelhos que aceitaram receber avisos (push da web): um por navegador/celular da pessoa.
model InscricaoPush {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  endpoint  String   @unique @db.VarChar(1000)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("inscricoes_push")
}

// Sessões de login (express-session + connect-pg-simple). Ficam no banco porque na
// Vercel cada requisição pode cair numa instância diferente do servidor.
model Sessao {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// Pedidos de "esqueci minha senha". Guarda só o hash (sha256) do código enviado por email:
// quem lê o banco não consegue usar o link.
model RedefinicaoSenha {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("redefinicoes_senha")
}
